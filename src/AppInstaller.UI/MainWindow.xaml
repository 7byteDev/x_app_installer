
<Window x:Class="AppInstaller.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AppInstaller.UI.ViewModels" Title="App Installer">
 <Grid x:Name="Root" Background="#0D151D" RequestedTheme="Dark" Padding="12" RowSpacing="10">
  <Grid.Resources>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,10"/></Style>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#121D27"/><Setter Property="BorderBrush" Value="#263440"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/></Style>
   <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A7BDD1"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="194"/><RowDefinition Height="54"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Viewbox Width="40" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="X logo"><Path Width="40" Height="48" Stretch="Uniform" Fill="#168FFF" Data="M0,0 L12,0 L20,15 L28,0 L40,0 L26,24 L40,48 L28,48 L20,33 L12,48 L0,48 L14,24 Z"/></Viewbox>
   <StackPanel x:Name="HeaderDrag" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="App Installer" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Install and keep your essential tools up to date" Style="{StaticResource Muted}"/></StackPanel>
   <Button Grid.Column="2" Content="⚙  Settings" Click="Settings_Click" IsEnabled="{Binding Idle}" VerticalAlignment="Center"/>
   <Button Grid.Column="3" Content="⟳  Refresh" Click="Refresh_Click" IsEnabled="{Binding Idle}" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListView x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectionChanged="Category_Changed" SelectedIndex="0" Background="Transparent">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="vm:CategoryItem"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#A7BDD1"/></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="1" Spacing="8" Padding="10"><TextBlock Text="APPLICATION CATALOG" Foreground="#43ACFF" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Windows x64  •  .NET 10" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
   </Grid>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
     <TextBox x:Name="SearchBox" PlaceholderText="Search applications…" Margin="12,8" TextChanged="Search_Changed"/>
     <Grid Grid.Row="1" Padding="24,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBlock Text="APPLICATION" FontSize="11" Foreground="#A7BDD1"/><TextBlock Grid.Column="1" Text="LATEST" FontSize="11" Foreground="#A7BDD1"/><TextBlock Grid.Column="2" Text="CATEGORY" FontSize="11" Foreground="#A7BDD1"/></Grid>
     <ListView x:Name="AppList" Grid.Row="2" ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp,Mode=TwoWay}" Background="Transparent" IsEnabled="{Binding Idle}">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="42"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:AppItem"><Grid ColumnSpacing="10" ToolTipService.ToolTip="{Binding Definition.InstallationNotes}"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}" IsEnabled="{Binding CanSelect}" MinWidth="0"/>
       <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
       <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" ToolTipService.ToolTip="{Binding SourceStatus}" Foreground="{Binding StatusBrush}" FontSize="11"/><TextBlock Visibility="{Binding ReasonVisibility}" Text="{Binding SelectionReason}" Foreground="#55B7FF" FontSize="11"/></StackPanel>
       <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Latest}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Installed}" FontSize="10" Foreground="#849BAE" TextTrimming="CharacterEllipsis"/></StackPanel>
       <Border Grid.Column="4" Background="#243644" CornerRadius="8" Padding="7,5" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontSize="11" TextTrimming="CharacterEllipsis"/></Border>
      </Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="12,4"><Button Content="Select All" Click="SelectAll_Click" IsEnabled="{Binding Idle}" Padding="12,5"/><Button Content="Deselect All" Click="DeselectAll_Click" IsEnabled="{Binding Idle}" Padding="12,5"/></StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer><StackPanel Spacing="18">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding SelectedApp.Icon}" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding SelectedApp.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedApp.Latest}" Foreground="#29A7FF"/><HyperlinkButton Content="↗  Official site" Click="Official_Click" Padding="0"/></StackPanel></Grid>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#C6D6E6" LineHeight="23"/>
    <Border Background="#243644" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedApp.Category}" Foreground="{Binding SelectedApp.Accent}"/></Border>
    <Border Style="{StaticResource Card}" Padding="14"><StackPanel Spacing="10"><TextBlock Text="◇  Dependencies" FontWeight="SemiBold"/><TextBlock Text="{Binding Dependencies}" TextWrapping="Wrap" Foreground="#B9CCDC"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="14"><StackPanel Spacing="12"><TextBlock Text="⚙  Installation options" FontWeight="SemiBold"/><TextBlock Text="Installation uses the application’s supported scope. Windows requests administrator permission when required." TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedApp.Definition.InstallationNotes}" TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedApp.PackageSize}" TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock Text="Architecture: x64"/><TextBlock Text="Release check" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedApp.SourceStatus}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="#B9CCDC" FontSize="12"/><TextBlock Text="Installed version" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedApp.Installed}"/><TextBlock Text="Detected location" Visibility="{Binding SelectedApp.LocationVisibility}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedApp.Location}" Visibility="{Binding SelectedApp.LocationVisibility}" TextWrapping="Wrap" Foreground="#52B8FF" FontSize="12"/></StackPanel></Border>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="12"><TextBlock Text="{Binding Operation}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><ProgressBar Value="{Binding Overall}" Maximum="100" Height="8"/><TextBlock Text="{Binding Transfer}" FontSize="12" Foreground="#B6CCDF" TextWrapping="Wrap"/><ProgressBar Value="{Binding Current}" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Foreground="#23BE8A" Height="7"/><TextBlock Text="Verified downloads. Sequential installation. Clear results." Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
   <Border Grid.Column="1" Background="#0C141B" CornerRadius="8" Padding="12,6"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activity details" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Copy all" Click="CopyActivity_Click" Padding="8,2" FontSize="11" ToolTipService.ToolTip="Copy all activity messages to the clipboard"/></Grid><ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" SelectionMode="None" FontFamily="Consolas" FontSize="11" Foreground="#9FB5C7"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="18"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:ActivityLogItem"><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
  </Grid></Border>
  <Grid Grid.Row="3" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Content="Shut down PC after successful completion" IsChecked="{Binding Settings.ShutdownAfterSuccess,Mode=TwoWay}" IsEnabled="{Binding Idle}"/><Button Grid.Column="1" Content="{Binding SelectionLabel}" Click="InstallSelected_Click" Background="#008BFF" Foreground="White" IsEnabled="{Binding Idle}" Padding="22,12"/><Button Grid.Column="2" Content="{Binding AllLabel}" Click="InstallAll_Click" IsEnabled="{Binding Idle}"/><Button Grid.Column="3" Content="✕  Cancel" Click="Cancel_Click" IsEnabled="{Binding Busy}"/></Grid>
 </Grid>
</Window>


